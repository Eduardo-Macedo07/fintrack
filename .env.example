# Copie para .env.local e ajuste os valores. NUNCA commite o .env.local.

# Conexão com o PostgreSQL (valor abaixo funciona com o docker-compose.yml)
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack"

# Segredo do Auth.js (mín. 32 caracteres). Gere um com: openssl rand -base64 32
AUTH_SECRET=""

# Confiar no header Host. Necessário só ao rodar em produção FORA da Vercel
# (ex.: `npm run build && npm start` local ou servidor próprio). Na Vercel e em `npm run dev` não precisa.
# AUTH_TRUST_HOST=true
